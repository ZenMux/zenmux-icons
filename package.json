{
  "name": "@zenmux/icons",
  "version": "0.1.0-dev.8",
  "description": "Transparent AI brand SVG icons and React components by ZenMux.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*.svg": "./icons/*.svg",
    "./metadata.json": "./metadata.json",
    "./static/*": "./static/*",
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "import": "./dist/loaders.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "icons",
    "metadata.json",
    "README.md",
    "NOTICE",
    "static"
  ],
  "scripts": {
    "generate:readme": "node scripts/generate-readme.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && tsc --noEmit -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "svgo": "^3.3.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenMux/zenmux-icons.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "dev"
  }
}
